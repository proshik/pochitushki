<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!-- requestId приходит из RequestIdFilter. Раньше здесь печатались transaction.id и
         trace.id, которые никто не заполнял, — то есть пустые скобки в каждой строке. -->
    <property name="CONSOLE_LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS Z} [%X{requestId:-}] [%thread] %-5level [%class{0}] : %m%n${LOG_EXCEPTION_CONVERSION_WORD:-%wEx}"/>

    <appender name="ConsoleAppender" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="ConsoleAppender"/>
    </root>

    <!-- Уровень приложения задаётся в application.yml (logging.level), а не прибит здесь:
         на DEBUG в лог уезжают URL сохранённых ссылок и тела апдейтов Telegram. -->

    <!-- to suppress useless WARN: https://github.com/Netflix/Hystrix/issues/275 -->
    <logger name="com.netflix.config.sources.URLConfigurationSource" level="ERROR"/>
</configuration>
