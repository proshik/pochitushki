# Скопировать в .env.dev и поправить под себя. .env.dev в .gitignore.
#
#   cp .env.dev.example .env.dev
#   docker compose -f compose.dev.yaml --env-file .env.dev up -d

# --- приложение (на хосте, не в compose) ---

# Локально всё по http, поэтому Secure-куки не годятся: Safari не примет их с
# http://localhost, а с http://192.168.x.x их не примет ни один браузер — то есть
# с телефона иначе не зайти. В проде остаётся true.
COOKIE_SECURE=false

# Брокер вместо настоящего Telegram. Обе переменные меняются вместе: iss
# сверяется побайтово, и одной правки мало.
TELEGRAM_OAUTH_BASE_URL=http://127.0.0.1:8090
TELEGRAM_EXPECTED_ISSUER=http://127.0.0.1:8090

# В mock-режиме брокер наружу не ходит, так что годится что угодно непустое.
TELEGRAM_CLIENT_ID=pochitushki
TELEGRAM_CLIENT_SECRET=dev-secret

APP_BASE_URL=http://localhost:8080

# --- брокер (в compose) ---

# 32 байта base64url:
#   head -c 32 /dev/urandom | base64 | tr '+/' '-_' | tr -d '='
BROKER_REGISTRY_KEY=ЗАМЕНИТЬ-НА-СВОЙ-КЛЮЧ-32-БАЙТА-BASE64URL

# Впишите свой настоящий Telegram ID: локальные данные должны сойтись с боевыми.
BROKER_MOCK_USERS=[{"id":123456789,"name":"Я","username":"me"}]

# client_secret здесь обязан совпасть с TELEGRAM_CLIENT_SECRET выше.
BROKER_CLIENTS={"pochitushki":{"secret":"dev-secret"}}
